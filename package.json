{
  "name": "cobrosync",
  "private": true,
  "version": "1.0.0",
  "description": "CobroSync: gestión documental y cobranzas de facturas a compañías de seguros",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "datos:demo": "node scripts/generar-datos-demo.mjs",
    "build:google": "vite build --mode google && node scripts/empaquetar-google.mjs",
    "test:google": "node scripts/probar-google.mjs",
    "test:apps-script": "node scripts/probar-apps-script.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.6.0",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "vite-plugin-singlefile": "^2.3.0",
    "playwright": "^1.49.0"
  }
}
